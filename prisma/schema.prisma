generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADMIN_ADJUSTMENT
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  balance      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  orders              Order[]
  walletTransactions  WalletTransaction[]
  depositRequests     DepositRequest[]
  reviewedDeposits    DepositRequest[]      @relation("DepositReviewer")
  adminTransactions   WalletTransaction[]   @relation("TransactionAdmin")

  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(12, 2)
  category    String
  imageUrl    String?
  stock       Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([category])
  @@index([active, featured])
  @@map("products")
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  userId              String
  productId           String
  productNameSnapshot String
  priceSnapshot       Decimal     @db.Decimal(12, 2)
  status              OrderStatus @default(PROCESSING)
  adminNote           String?
  createdAt           DateTime    @default(now())
  completedAt         DateTime?

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product              @relation(fields: [productId], references: [id])
  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model WalletTransaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String
  orderId     String?         @unique
  adminId     String?
  createdAt   DateTime        @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  admin User?  @relation("TransactionAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("wallet_transactions")
}

model DepositRequest {
  id         String        @id @default(cuid())
  userId     String
  amount     Decimal       @db.Decimal(12, 2)
  status     DepositStatus @default(PENDING)
  adminNote  String?
  reviewedBy String?
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("DepositReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("deposit_requests")
}
